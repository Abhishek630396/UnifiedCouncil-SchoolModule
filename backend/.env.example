PORT=8000

# SQL Server connection
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=UnifiedCouncil
DB_USER=your_sql_server_username
DB_PASSWORD=your_sql_server_password

# Optional fallback when DB_SERVER and DB_DATABASE are not set.
# DB_CONNECTION_STRING=Server=your-server,1433;Database=your-database;User Id=your-username;Password=your-password;Encrypt=true;TrustServerCertificate=true

# Used when connecting with DB_SERVER/DB_PORT/DB_DATABASE/DB_USER/DB_PASSWORD.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Additional login required to view or update exam prices.
# Store the password as a PBKDF2-SHA512 hash: saltHex:hashHex (48 and 128 hex characters).
# Generate a hash with crypto.pbkdf2Sync(password, salt, 310000, 64, "sha512").
# Store the salt and derived hash as lowercase hex, separated by a colon.